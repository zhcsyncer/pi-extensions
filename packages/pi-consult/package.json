    "pi",
    "pi-coding-agent",
    "advisor",
    "consult",
    "second-opinion"
  ],
  "type": "module",
  "license": "MIT",
  "author": "zhcsyncer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhcsyncer/pi-extensions.git",
    "directory": "packages/pi-consult"
  },
  "homepage": "https://github.com/zhcsyncer/pi-extensions/tree/main/packages/pi-consult#readme",
  "bugs": {
    "url": "https://github.com/zhcsyncer/pi-extensions/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
